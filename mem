# --- Top-level dispatcher -----------------------------------------------------

main() {
  # §8 content-first: `mem` with no args shows the home view (live state, not help).
  # `mem --help` / `mem help` / `mem -h` shows the top-level help block.
  if [[ $# -eq 0 ]]; then
    cmd_home
    return $?
  fi
  local cmd="$1"
  if [[ "$cmd" == "--help" || "$cmd" == "-h" || "$cmd" == "help" ]]; then
    cmd_help_top
    return 0
  fi
  if [[ "$cmd" == "--version" || "$cmd" == "-V" || "$cmd" == "version" ]]; then
    printf 'mem %s\n' "$MEM_VERSION"
    return 0
  fi
  shift
  case "$cmd" in
    init)   cmd_init   "$@" ;;
    search) cmd_search "$@" ;;
    show)   cmd_show   "$@" ;;
    add)    cmd_add    "$@" ;;
    update) cmd_update "$@" ;;
    merge)  cmd_merge  "$@" ;;
    dedup)  cmd_dedup  "$@" ;;
    list)   cmd_list   "$@" ;;
    review) cmd_review "$@" ;;
    sync)   cmd_sync   "$@" ;;
    status) cmd_status "$@" ;;
    stats)  cmd_stats  "$@" ;;
    *)
      die "unknown command: $cmd" 2 "run \`mem --help\` for the command list"
      ;;
  esac
}

main "$@"